# ══════════ 智学学堂 配置模板 ══════════
# 复制本文件为 .env 并填入实际值。不配置的项自动走默认值或降级。


# ── 数据库 ──
# DB_DRIVER: 仅支持 mysql（本项目已移除 SQLite，驱动被强制回退到 mysql）
DB_DRIVER=mysql
DB_HOST=mysql6..com
DB_PORT=3311
DB_USER=
DB_PASSWORD=
DB_NAME=schoolexam

# ── 采集暂存库（可选）──
# 主库达上限/不可用时，采集子系统先把试卷落本地 SQLite 暂存库，
# 再用 tools/qb_release.py generate 抽成脚本传线上 apply。
# 留空则采集照旧直接写主库 MySQL。
# STAGING_DB_URL=sqlite:///data/collected_staging.sqlite

# ── 运行日志（可选）──
# 输出到 log/ 目录：每天一个文件，单文件超过上限再按 part 序号拆分。
# LOG_DIR：日志目录，默认 <项目根>/log
# LOG_MAX_BYTES：单文件大小上限（字节），默认 20971520（20MB），<=0 表示不按大小拆分
# LOG_KEEP_DAYS：保留天数，默认 30，<=0 表示永久保留
# LOG_DIR=log
# LOG_MAX_BYTES=20971520
# LOG_KEEP_DAYS=30

# ── AI ──
# 不配置时：AI 错题讲解/成长周报/鼓励语自动降级为本地模板，其余功能不受影响
# 智谱 API Key（open.bigmodel.cn 控制台获取）
ZHIPU_API_KEY=.
# 模型（默认 glm-4.7-flash 轻量档，成本低）
AI_MODEL=glm-4.7
# 接口地址（默认智谱 OpenAI 兼容接口，一般无需修改）
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 讯飞星火 Lite（免费档，可选）
XF_API_PASSWORD=lIMWGuXZsFwdjfcSkCwF:lOfEoIoevigaROOYAKIN
# 或老式组合（APIKey 与 APISecret 各 32 位），系统自动按 APIKey:APISecret 鉴权：
XF_API_KEY=
XF_API_SECRET=

# DeepSeek（付费档，仅 VIP 用户回退时使用，可选）
DEEPSEEK_API_KEY=sk-
# 备用中转站（可选，未配置 RELAY_API_KEY 自动跳过）
RELAY_API_KEY=sk-
RELAY_BASE_URL=https://hubway.cc/v1
RELAY_MODEL=gpt-5.5

# ── 邮件（注册/绑定/重置密码验证码） ──
MAIL_SERVER=smtp.qiye.163.com
MAIL_PORT=465
MAIL_ADDRESS=
MAIL_PASSWORD=

# ── 天气（和风天气） ──
QWEATHER_API_KEY=
QWEATHER_API_HOST=
# IP 定位（可选，不配置则用默认城市）
IPINFO_API_TOKEN=

# ── 短信（暂不启用，预留） ──
SMS_PROVIDER=
SMS_API_KEY=

# ── 安全/签名 ──
# 同步学单元小测答案令牌的 HMAC 签名密钥（默认 zhixue_sync_quiz_v1，与历史令牌兼容）。
# 如需轮换密钥，修改后旧令牌将验签失败（用户重新进入单元小测即可重新签发）。
QUIZ_SECRET=zhixue_sync_quiz_v1

# ── 兼容开关 ──
# 昵称快捷登录：存量用户兼容入口，正式上线前置为 false
ALLOW_NICKNAME_LOGIN=true
